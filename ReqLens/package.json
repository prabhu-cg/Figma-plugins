{
  "name": "reqlens",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin that analyzes selected frames and generates contextual requirements-elicitation questions.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:watch",
    "build": "npm run build:ui && npm run build:main",
    "build:ui": "vite build --config vite.config.ui.ts",
    "build:main": "vite build --config vite.config.main.ts",
    "build:watch": "concurrently -n ui,main -c blue,green \"vite build --config vite.config.ui.ts --watch\" \"vite build --config vite.config.main.ts --watch\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.99.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.2"
  }
}
