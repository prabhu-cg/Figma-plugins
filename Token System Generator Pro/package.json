{
  "name": "Token-System-Generator-Pro",
  "version": "1.0.0",
  "description": "Figma plugin that generates a complete design token system as Figma variables",
  "main": "code.js",
  "scripts": {
    "build": "npm run typecheck && esbuild code.ts --bundle --target=es2017 --outfile=code.js",
    "lint": "eslint --ext .ts,.tsx --ignore-pattern node_modules .",
    "lint:fix": "eslint --ext .ts,.tsx --ignore-pattern node_modules --fix .",
    "watch": "esbuild code.ts --bundle --target=es2017 --outfile=code.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "esbuild algorithms.ts --bundle --format=cjs --outfile=.test-build/algorithms.js",
    "test": "node tests/algorithms.test.js"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  }
}
